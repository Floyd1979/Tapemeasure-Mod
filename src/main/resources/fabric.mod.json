	"authors": [
		"Ray"
	],
	"icon": "assets/tapemeasure/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.divinitysreach.tapemeasure.TapeMeasureClient"
		],
		"modmenu": [
			"com.divinitysreach.tapemeasure.gui.ModMenuIntegration"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
